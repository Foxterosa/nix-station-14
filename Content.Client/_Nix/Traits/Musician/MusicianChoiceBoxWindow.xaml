<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc musician-box-title}"
    MinSize="360 160"
    SetSize="380 180">
    <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10">
        <Label Text="{Loc musician-box-prompt}" />
        <OptionButton Name="InstrumentOption" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="10">
            <Button Name="CancelButton" Text="{Loc musician-box-cancel}" MinWidth="80" />
            <Button Name="OkButton" Text="{Loc musician-box-ok}" StyleClasses="Caution" MinWidth="80" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
