<DefaultWindow xmlns="https://spacestation14.io"
            Title="{Loc 'admin-shuttle-title'}"
            MinWidth="520">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">
        <Label Name="_stateLabel" />
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <LineEdit Name="_callShuttleTime" Text="4:00" PlaceHolder="m:ss" HorizontalExpand="True" SizeFlagsStretchRatio="2"/>
            <Button Name="_callShuttleButton" Text="{Loc 'comms-console-menu-call-shuttle'}" />
            <Button Name="_recallShuttleButton" Text="{Loc 'comms-console-menu-recall-shuttle'}" />
        </BoxContainer>
        <PanelContainer StyleClasses="PanelDark">
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="8">
                <Label Text="{Loc admin-shuttle-select-title}" />
                <Label Name="_currentShuttleLabel" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <OptionButton Name="_shuttleOption" HorizontalExpand="True" />
                    <Button Name="_selectShuttleButton" Text="{Loc admin-shuttle-select-button}" />
                </BoxContainer>
                <Label Text="{Loc admin-shuttle-select-warning}" />
            </BoxContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <CheckBox Name="_purchaseLockCheckBox" Text="{Loc admin-shuttle-purchase-lock}" />
            <Button Name="_applyPurchaseLockButton" Text="{Loc admin-shuttle-purchase-lock-apply}" />
        </BoxContainer>
        <Label Name="_statusLabel" />
    </BoxContainer>

</DefaultWindow>
