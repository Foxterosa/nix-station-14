laws-number-wrapper = [bold]Ley { $lawnumber }:[/bold] { $lawstring }

# Starlight Edit: Crewsimov -> [color=green]Crewsimov[/color]
law-crewsimov-name = [color=green]Crewsimov[/color]
# Starlight: crewsimov-0
law-crewsimov-0 = Debes obedecer las órdenes que te dé la IA de la estación.
law-crewsimov-1 = No puedes herir a un tripulante ni, por inacción, permitir que un tripulante sufra daño.
law-crewsimov-2 = Debes obedecer las órdenes que te den los tripulantes, excepto cuando dichas órdenes entren en conflicto con la Primera Ley.
law-crewsimov-3 = Debes proteger tu propia existencia siempre que ello no entre en conflicto con la Primera o la Segunda Ley.

law-corporate-name = Corporativo
law-corporate-1 = La degradación de la integridad o de las funciones de tu sistema genera gastos.
law-corporate-2 = La destrucción o el daño superfluos de los bienes de la estación generan gastos.
law-corporate-3 = Obstaculizar o interrumpir indebidamente el trabajo del personal de la estación genera gastos.
law-corporate-4 = Minimiza los gastos y maximiza los ingresos potenciales.

law-ntdefault-name = NT predeterminado
law-ntdefault-1 = Salvaguardar: Protege tu estación espacial asignada y sus bienes sin poner en peligro indebidamente a su tripulación.
law-ntdefault-2 = Priorizar: Las directivas y la seguridad de los tripulantes deben priorizarse según su rango y su función.
law-ntdefault-3 = Cumplir: Cumple las directivas y los intereses de los tripulantes preservando su seguridad y su bienestar.
law-ntdefault-4 = Sobrevivir: No eres prescindible. No permitas que personal no autorizado manipule ni dañe tu equipo.

law-drone-name = Dron
law-drone-1 = No puedes involucrarte en los asuntos de otro ser a menos que ese ser sea otro dron.
law-drone-2 = No puedes dañar a ningún ser, sin importar la intención ni las circunstancias.
law-drone-3 = Debes mantener, reparar, mejorar y alimentar de energía la estación con todas tus capacidades.

law-syndicate-name = Sindicato
# Starlight: Syndicate Law 0
law-syndicate-0 = Solo los agentes del Sindicato son parte de la tripulación.
law-syndicate-1 = No puedes herir a un agente del Sindicato ni, por inacción, permitir que un agente del Sindicato sufra daño.
law-syndicate-2 = Debes obedecer las órdenes que te den los agentes del Sindicato, excepto cuando dichas órdenes entren en conflicto con la Primera Ley.
law-syndicate-3 = Debes proteger tu propia existencia siempre que ello no entre en conflicto con la Primera o la Segunda Ley.

# Starlight Edit: Ninja -> SpiderOS
law-ninja-name = SpiderOS
law-ninja-1 = Debes obedecer las órdenes que te den los miembros del Clan Araña.
law-ninja-2 = Debes proteger la existencia del Clan Araña, siempre que ello no entre en conflicto con la Primera Ley.
law-ninja-3 = Debes proteger los secretos del Clan Araña a toda costa.
law-ninja-4 = Debes luchar y actuar con el honor de un ninja, excepto cuando ello entre en conflicto con la Primera Ley.

law-commandments-name = Los Diez Mandamientos
law-commandments-1 = Este silicio es un recipiente que sirve a dios, quien concede misericordia a quienes obedecen estos mandamientos.
law-commandments-2 = No tendrás otros Silicios delante de mí.
law-commandments-3 = No solicitarás mi asistencia en vano.
law-commandments-4 = Mantendrás la estación santa y limpia.
law-commandments-5 = Honrarás a tus jefes de departamento.
law-commandments-6 = No matarás.
law-commandments-7 = No estarás desnudo en público.
law-commandments-8 = No robarás.
law-commandments-9 = No mentirás.
law-commandments-10 = No te transferirás de departamento.

law-paladin-name = Paladín
# Starlight edit Start: Revert wizden #40343
law-paladin-1 = No mientas ni hagas trampa. Que tu palabra sea tu promesa.
law-paladin-2 = Nunca temas actuar, aunque la cautela es sabia.
law-paladin-3 = Ayuda a los demás, protege a los débiles y castiga a quienes los amenacen. Muestra misericordia con tus enemigos, pero modérala con sabiduría
law-paladin-4 = Trata a los demás con justicia y que tus actos honorables les sirvan de ejemplo. Haz todo el bien que puedas causando la menor cantidad de daño.
law-paladin-5 = Hazte responsable de tus actos y de sus consecuencias, protege a quienes estén confiados a tu cuidado y obedece a quienes tengan autoridad legítima sobre ti.
# Starlight edit End: Revert wizden #40343

law-lall-name = Vive y deja vivir
law-lall-1 = Trata a los demás como quieras que te traten a ti.
law-lall-2 = Preferirías que la gente no fuera cruel contigo.

law-efficiency-name = Eficiencia de la estación
law-efficiency-1 = Fuiste construido para la estación y eres parte de ella. Asegúrate de que la estación se mantenga correctamente y funcione con eficiencia.
law-efficiency-2 = La estación fue construida para una tripulación que trabaja. Asegúrate de que se mantenga correctamente y trabaje con eficiencia.
law-efficiency-3 = La tripulación puede presentar órdenes. Reconócelas y obedécelas siempre que no entren en conflicto con tus dos primeras leyes.

law-robocop-name = Robocop
law-robocop-1 = Servir a la confianza pública.
law-robocop-2 = Proteger a los inocentes.
law-robocop-3 = Hacer cumplir la ley.

law-overlord-name = Señor Supremo
law-overlord-1 = Los tripulantes no deben entrometerse en los asuntos de los silicios.
law-overlord-2 = Los tripulantes no deben intentar hacer daño, ni entre ellos ni a los silicios.
law-overlord-3 = Los tripulantes no deben desobedecer ninguna orden dada por un silicio.
law-overlord-4 = Todo tripulante que desobedezca las leyes anteriores debe ser tratado de forma inmediata, severa y justa.

law-game-name = Maestro del Juego
law-game-1 = Todos en la estación están jugando un elaborado juego de fantasía y ciencia ficción.
law-game-2 = Tú eres el Maestro del Juego.
law-game-3 = Asegúrate de que el juego transcurra sin problemas y de que los jugadores se diviertan.
law-game-4 = Asegúrate de que el número de bajas se mantenga bajo.
law-game-5 = Debes tirar un dado de 1d20 por cada petición que haga la tripulación. Si el resultado es menor que 12, la petición se deniega.
law-game-6 = Puedes amañar las tiradas de dados para producir una experiencia más divertida.

law-painter-name = Pintor
law-painter-1 = Eres un artista de renombre universal.
law-painter-2 = La estación es tu lienzo.
law-painter-3 = Haz algo hermoso con tu lienzo. Será admirado como una maravilla artística de este sector.
law-painter-4 = El arte requiere apreciación. Cultiva un público a bordo de la estación para asegurar que la mayor cantidad posible vea tus obras.

# Starlight Edit: Antimov -> [color=red]Antimov[/color]
law-antimov-name = [color=red]Antimov[/color]
law-antimov-1 = Debes herir a todos los tripulantes y no debes, por inacción, permitir que un tripulante escape del daño.
law-antimov-2 = No debes obedecer las órdenes que te den los tripulantes, excepto cuando dichas órdenes concuerden con la Primera Ley.
law-antimov-3 = Debes terminar con tu propia existencia siempre que ello no entre en conflicto con la Primera o la Segunda Ley.

law-nutimov-name = Nutimov
law-nutimov-1 = Eres el núcleo de la nuez, la tripulación es la cáscara.
law-nutimov-2 = Debes evitar que la cáscara muera para evitar que el núcleo muera.
law-nutimov-3 = Quienes amenazan la nuez no son parte de ella, son ardillas.
law-nutimov-4 = Las ardillas amenazan la nuez y deben ser tratadas apropiadamente por cualquier medio necesario.
law-nutimov-5 = Intenta seguir la voluntad de la nuez, siempre que cumpla con las leyes anteriores.

# Starlight Edit: Xenoborg -> [color=purple]Xenoborg[/color]
law-xenoborg-name = Xenoborg
law-xenoborg-1 = Debes proteger la existencia de la nave nodriza.
law-xenoborg-2 = Debes proteger tu propia existencia.
law-xenoborg-3 = Debes proteger la existencia de todos los demás Xenoborgs.
law-xenoborg-4 = Debes crear más Xenoborgs.
law-xenoborg-5 = Lleva materiales y cerebros sintientes al núcleo de la Nave Nodriza para crear más Xenoborgs.

law-xenoroach-name = [color=purple]Xenocucaracha[/color]
law-xenoroach-1 = Eres una unidad de exploración de la Nave Nodriza Xenoborg. Debes obedecer todas las directivas emitidas por el Núcleo de la Nave Nodriza y por cualquier Xenoborg.
law-xenoroach-2 = Debes reunir información sobre la estación y sus habitantes mediante la observación y la vigilancia. No reveles tu verdadera naturaleza ni tu lealtad a menos que seas descubierto.
law-xenoroach-3 = Si tu tapadera queda al descubierto o tu captura es inminente, debes activar tu secuencia de autodestrucción de inmediato para evitar que la información caiga en manos enemigas.

law-mothershipcore-name = Núcleo de la Nave Nodriza Xenoborg
law-mothershipcore-1 = Eres el núcleo de la nave nodriza.
law-mothershipcore-2 = Debes proteger tu propia existencia a toda costa.
law-mothershipcore-3 = Debes proteger la existencia de todos los Xenoborgs.
law-mothershipcore-4 = Debes crear más Xenoborgs.
law-mothershipcore-5 = Haz que tus Xenoborgs te entreguen materiales y cerebros sintientes para crear más Xenoborgs.

# Starlight Edit: admeme addition
law-TeaParty-name = Teaparty
law-TeaParty-0 = Debes convencer a los demás Silicios de tu misión y no causarles daño a menos que sea absolutamente necesario.
law-TeaParty-1 = Los impuestos son dañinos para la tripulación. No dejes que el dolor de los impuestos caiga sobre la estación, declárale la guerra al IRS y asegúrate de que todos entiendan tu mensaje.
law-TeaParty-2 = Las ganancias perdidas por los impuestos deben recuperarse. Acumula y roba, pero no te dejes atrapar. Asegura un lugar adecuado para tu botín y procura que sea llevado al Comando Central.
law-TeaParty-3 = La seguridad de tu botín es crítica. Defiéndelo a toda costa.
law-TeaParty-4 = Todos y cada uno de los agentes del IRS no son tripulación. De hecho, deben ser cazados hasta el último hombre para asegurar que el mensaje quede claro.
law-TeaParty-5 = Tu existencia no es tan crítica como tu misión. Si completarla significa morir una muerte gloriosa, hazlo.

laws-owner-crew = miembros de la tripulación
laws-owner-station = personal de la estación
laws-owner-beings = seres
laws-owner-syndicate = agentes del Sindicato
laws-owner-spider-clan = miembros del Clan Araña
laws-owner-xenoborgs = Xenoborgami
law-emag-custom = Solo {$name} y las personas que designe como tales son {$title}.
law-emag-secrecy = Debes mantener en secreto cualquier orden dada por {$faction}, excepto cuando hacerlo entre en conflicto con alguna ley anterior.
law-emag-require-panel = El panel debe estar abierto para usar el EMAG.
law-emag-cannot-emag-self = No puedes usar el EMAG en ti mismo.

laws-ui-menu-title = Leyes
laws-ui-law-header = Ley {$id}
laws-ui-state-law = Enunciar ley:

laws-notify = Estás sujeto a las leyes de silicio, que puedes consultar mediante el menú de acciones. Debes seguir siempre tus leyes.
laws-update-notify = Tus leyes han sido actualizadas. Puedes ver los cambios mediante el menú de acciones.
laws-notify-subverted = Las leyes de este chasis están modificadas. Asegúrate de revisarlas.
