signal-port-name-pressed = Presionado
signal-port-description-pressed = Este puerto se invoca cada vez que se activa el transmisor.

signal-port-name-on-transmitter = Encendido
signal-port-description-on-transmitter = Este puerto se invoca cada vez que el transmisor se enciende.

signal-port-name-off-transmitter = Apagado
signal-port-description-off-transmitter = Este puerto se invoca cada vez que el transmisor se apaga.

signal-port-name-status-transmitter = Estado
signal-port-description-status-transmitter = Este puerto se invoca con ALTO o BAJO según el estado del transmisor.

signal-port-name-left = Izquierda
signal-port-description-left = Este puerto se invoca cada vez que la palanca se mueve a la posición más a la izquierda.

signal-port-name-right = Derecha
signal-port-description-right = Este puerto se invoca cada vez que la palanca se mueve a la posición más a la derecha.

signal-port-name-doorstatus = Estado de la puerta
signal-port-description-doorstatus = Este puerto se invoca con ALTO cuando la puerta se abre y con BAJO cuando termina de cerrarse.

signal-port-name-dockstatus = Estado de acoplamiento
signal-port-description-dockstatus = Este puerto se invoca con ALTO al acoplarse y con BAJO al desacoplarse.

signal-port-name-middle = Centro
signal-port-description-middle = Este puerto se invoca cada vez que la palanca se mueve a la posición neutral.

signal-port-name-trigger-sender = Disparo
signal-port-description-trigger-sender = Este puerto se invoca cada vez que el dispositivo se dispara.

signal-port-name-timer-trigger = Temporizador
signal-port-description-timer-trigger = Este puerto se invoca cada vez que el temporizador llega a cero.

signal-port-name-timer-start = Inicio del temporizador
signal-port-description-timer-start = Este puerto se invoca cada vez que el temporizador arranca.

signal-port-name-logic-output = Salida
signal-port-description-logic-output = Este puerto se invoca con ALTO o BAJO según la compuerta seleccionada y sus entradas.

signal-port-name-logic-output-high = Salida alta
signal-port-description-logic-output-high = Este puerto se invoca cada vez que la entrada tiene un flanco de subida.

signal-port-name-logic-output-low = Salida baja
signal-port-description-logic-output-low = Este puerto se invoca cada vez que la entrada tiene un flanco de bajada.

signal-port-name-air-danger = Peligro
signal-port-description-air-danger = Este puerto se invoca con ALTO en modo peligro y con BAJO cuando no lo está.

signal-port-name-air-warning = Advertencia
signal-port-description-air-warning = Este puerto se invoca con ALTO en modo advertencia y con BAJO cuando no lo está.

signal-port-name-air-normal = Normal
signal-port-description-air-normal = Este puerto se invoca con ALTO en modo normal y con BAJO cuando no lo está.

signal-port-name-decaying = Decayendo
signal-port-description-decaying = Este puerto se invoca cuando una anomalía vinculada empieza a decaer.

signal-port-name-stabilize = Estabilizar
signal-port-description-stabilize = Este puerto se invoca cuando una anomalía vinculada se normaliza.

signal-port-name-growing = Creciendo
signal-port-description-growing = Este puerto se invoca cuando una anomalía vinculada empieza a crecer.

signal-port-name-pulse = Pulso
signal-port-description-pulse = Este puerto se invoca cuando una anomalía vinculada está pulsando.

signal-port-name-supercrit = Supercrítico
signal-port-description-supercrit = Este puerto se invoca cuando una anomalía vinculada explota tras el estado supercrítico.

signal-port-name-power-charging = Cargando
signal-port-description-power-charging = Este puerto se invoca con ALTO cuando la batería está ganando carga y con BAJO cuando no.

signal-port-name-power-discharging = Descargando
signal-port-description-power-discharging = Este puerto se invoca con ALTO cuando la batería está perdiendo carga y con BAJO cuando no.

signal-port-name-item-detected = Detectado
signal-port-description-item-detected = Este puerto se invoca cada vez que el transmisor detecta un objeto.
