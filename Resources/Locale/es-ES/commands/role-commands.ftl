cmd-addrole-desc = Añade un rol a la mente de un jugador.
cmd-addrole-help = Uso: addrole <session ID> <role>
cmd-addrole-mind-not-found = No se pudo encontrar esa mente.
cmd-addrole-role-not-found = No se pudo encontrar ese rol.
cmd-addrole-mind-already-has-role = La mente ya tiene ese rol.

cmd-listroles-desc = Enumera todos los roles disponibles.
cmd-listroles-help = Uso: listroles

cmd-rmrole-desc = Elimina un rol de la mente de un jugador.
cmd-rmrole-help = Uso: rmrole <ID de sesión> <tipo de rol>
                  El tipo de rol es el nombre real del tipo de C#.
