thief-backpack-window-title = Kit de ladrón

thief-backpack-window-description =
    Adentro están tus herramientas de trabajo, que se disolverán cuando estés listo.
    Elige {$maxCount} {$maxCount ->
        [1] conjunto distinto
        *[other] conjuntos distintos
    } de la lista.

thief-backpack-window-selected = Kits seleccionados: ({$selectedCount}/{$maxCount})

thief-backpack-window-approve-button = Aprobar
thief-backpack-button-select = Elegir [  ]
thief-backpack-button-deselect = Elegir [X]

# Sets

thief-backpack-category-chameleon-name = Kit camaleón
thief-backpack-category-chameleon-description =
    Eres todos y no eres nadie; eres un maestro del disfraz.
    Incluye: un set completo de ropa camaleón con ID de agente,
    un proyector camaleón y un implante falso de escudo mental.
    Disfrázate de quien sea y de lo que sea.

thief-backpack-category-tools-name = Kit de asalto
thief-backpack-category-tools-description =
    ¿Qué es ese ruido? Un poquito de C4 tocando a su puerta.
    ¡Ningún obstáculo puede detenerte!
    Incluye: dos C4, una multiherramienta, un señalizador remoto, quijadas de la vida,
    una soldadora avanzada, lentes de ingeniería y guantes aislantes.

thief-backpack-category-chemistry-name = Kit de anatomía
thief-backpack-category-chemistry-description =
    Alcanzaste tu máximo rendimiento físico... con una ayudita.
    Incluye: implantador de almacenamiento, implantador de codificador de ADN,
    botella de efedrina, jeringa, coctelera vacía y jabón omega

thief-backpack-category-syndie-name = Kit Syndie
thief-backpack-category-syndie-description =
    ¿Baratijas de un pasado renegado, o robadas a un agente descuidado?
    Hiciste tus contactos. Whiskey, echo...
    Incluye: un Emag, un rompedor de accesos, cigarrillos Interdyne, una palabra clave del Sindicato,
    un inhibidor de radio, un encendedor y unos extraños cristales rojos.

thief-backpack-category-sleeper-name = Kit somnífero
thief-backpack-category-sleeper-description =
    Hasta que cerremos los ojos para siempre, usa tus recetas ilegales
    para mantener dormidos a los demás.
    Incluye: un tanque somnífero de óxido nitroso, dos botellas de nocturina
    y un hipobolígrafo.

thief-backpack-category-communicator-name = Kit de comunicador
thief-backpack-category-communicator-description =
    El dinero es poder, y los secretos son dinero. Usa tu labia
    y tu fortuna para subvertir la estación.
    Incluye: llave maestra para todos los canales de la estación, un bolígrafo CyberSun,
    un implantador de máscara de voz y 20 mil spesos dentro de un maletín.

thief-backpack-category-smuggler-name = Kit de contrabandista
thief-backpack-category-smuggler-description =
    Todo ladrón necesita un rincón oscuro donde esconder su botín.
    No olvides vincular tu fulton.
    Incluye: baliza fulton, 10 fultons, 3 granadas de humo
    y una caja invisible para ocultar el botín valioso.
