addtag-command-description = Agrega una etiqueta a una entidad dada
addtag-command-help = Uso: addtag <uid de entidad> <etiqueta>

addtag-command-success = Se agregó {$tag} a {$target}.
addtag-command-fail = No se pudo agregar {$tag} a {$target}.

removetag-command-description = Quita una etiqueta de una entidad dada
removetag-command-help = Uso: removetag <uid de entidad> <etiqueta>

removetag-command-success = Se quitó {$tag} de {$target}.
removetag-command-fail = No se pudo quitar {$tag} de {$target}.

tag-command-arg-tag = Etiqueta
