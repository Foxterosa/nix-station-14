cmd-panicbunker-desc = Alterna el búnker de pánico, que activa restricciones más estrictas sobre quién puede unirse al servidor.
cmd-panicbunker-help = Uso: panicbunker
panicbunker-command-enabled = Se activó el búnker de pánico.
panicbunker-command-disabled = Se desactivó el búnker de pánico.

cmd-panicbunker_disable_with_admins-desc = Alterna si el búnker de pánico se desactiva o no cuando se conecta un admin.
cmd-panicbunker_disable_with_admins-help = Uso: panicbunker_disable_with_admins
panicbunker-command-disable-with-admins-enabled = El búnker de pánico se desactivará automáticamente cuando haya admins en línea.
panicbunker-command-disable-with-admins-disabled = El búnker de pánico no se desactivará automáticamente cuando haya admins en línea.

cmd-panicbunker_enable_without_admins-desc = Alterna si el búnker de pánico se activa o no cuando se desconecta el último admin.
cmd-panicbunker_enable_without_admins-help = Uso: panicbunker_enable_without_admins
panicbunker-command-enable-without-admins-enabled = El búnker de pánico se activará automáticamente cuando no haya admins en línea.
panicbunker-command-enable-without-admins-disabled = El búnker de pánico no se activará automáticamente cuando no haya admins en línea.

cmd-panicbunker_count_deadminned_admins-desc = Alterna si se cuentan o no los admins desadminados al activar y desactivar automáticamente el búnker de pánico.
cmd-panicbunker_count_deadminned_admins-help = Uso: panicbunker_count_deadminned_admins
panicbunker-command-count-deadminned-admins-enabled = El búnker de pánico contará a los admins desadminados cuando se active y desactive automáticamente.
panicbunker-command-count-deadminned-admins-disabled = El búnker de pánico no contará a los admins desadminados cuando se active y desactive automáticamente.

cmd-panicbunker_show_reason-desc = Alterna si se les muestra o no a los clientes que se conectan el motivo por el que el búnker de pánico les impidió unirse.
cmd-panicbunker_show_reason-help = Uso: panicbunker_show_reason
panicbunker-command-show-reason-enabled = Ahora el búnker de pánico mostrará un motivo a los usuarios cuya conexión bloquee.
panicbunker-command-show-reason-disabled = El búnker de pánico ya no mostrará un motivo a los usuarios cuya conexión bloquee.

cmd-panicbunker_min_account_age-desc = Obtiene o define la antigüedad mínima de cuenta, en minutos, que debe tener una cuenta para poder conectarse con el búnker de pánico activado.
cmd-panicbunker_min_account_age-help = Uso: panicbunker_min_account_age <minutos>
panicbunker-command-min-account-age-is = La antigüedad mínima de cuenta para el búnker de pánico es de {$minutes} minutos.
panicbunker-command-min-account-age-set = Se definió la antigüedad mínima de cuenta para el búnker de pánico en {$minutes} minutos.

cmd-panicbunker_min_overall_minutes-desc = Obtiene o define el tiempo total de juego mínimo, en minutos, que debe tener una cuenta para poder conectarse con el búnker de pánico activado.
cmd-panicbunker_min_overall_minutes-help = Uso: panicbunker_min_overall_minutes <minutos>
panicbunker-command-min-overall-minutes-is = El tiempo total de juego mínimo para el búnker de pánico es de {$minutes} minutos.
panicbunker-command-min-overall-minutes-set = Se definió el tiempo total de juego mínimo para el búnker de pánico en {$minutes} minutos.
