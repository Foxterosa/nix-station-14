cmd-announce-desc = Envía un anuncio dentro del juego con color y sonido personalizados.
cmd-announce-help = {$command} <mensaje> [remitente] [color] [sonido] - Envía un anuncio. El remitente por defecto es CentCom, el color Gold y el sonido announce.ogg. El color debe estar en formato #RRGGBB.

# The default sender for the announcement
cmd-announce-sender = Comando Central

# Completion hints
cmd-announce-arg-message = <mensaje>
cmd-announce-arg-sender = [remitente]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sonido]
