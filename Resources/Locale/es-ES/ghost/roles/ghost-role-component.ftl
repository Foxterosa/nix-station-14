# also used in MakeGhostRuleWindow and MakeGhostRoleCommand
ghost-role-component-default-rules = Se aplican todas las reglas normales, salvo que un administrador te indique lo contrario.
                                     No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                     Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                     Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-nonantagonist-rules = Eres [color={role-type-crew-aligned-alternate-color}][bold]{role-type-crew-aligned-name}[/bold][/color]. Por lo general no deberías buscar dañar a la estación ni a su tripulación.
                                             No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                             Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                             Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-freeagent-rules = Eres un [color={role-type-free-agent-color}][bold]{role-type-free-agent-name}[/bold][/color]. Puedes actuar tanto de antagonista como de no antagonista.
                                         No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                         Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                         Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-antagonist-rules = Eres un [color={role-type-solo-antagonist-color}][bold]{role-type-solo-antagonist-name}[/bold][/color]. Tus intenciones son claras, y dañinas para la estación y su tripulación.
                                          No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                          Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                          Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-rules-team-antagonist = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color]. Tus intenciones son claras, y dañinas para la estación y su tripulación.
                                               Debes [bold]trabajar con tu equipo[/bold] o seguir las indicaciones razonables de tus líderes.
                                               No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                               Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                               Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-familiar-rules = Eres un [color={role-type-familiar-color}][bold]{role-type-familiar-name}[/bold][/color]. Sirve a los intereses de tu amo, sean cuales sean.
                                        No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                        Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                        Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].
ghost-role-information-silicon-rules = Eres un [color={role-type-silicon-color}][bold]{role-type-silicon-name}[/bold][/color]. Obedece tus leyes. Eres un {role-type-free-agent-name} si en este momento no estás sujeto a ninguna ley.
                                       No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                       Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                       Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].

ghost-role-information-mouse-name = Ratón
ghost-role-information-mouse-description = Un ratón hambriento y travieso.

ghost-role-information-cancer-mouse-name = Ratón Canceroso
ghost-role-information-cancer-mouse-description = Un ratón irradiado; propaga tu mal y busca comida.

ghost-role-information-mothroach-name = Cucapolilla
ghost-role-information-mothroach-description = Una cucapolilla tierna pero traviesa.

ghost-role-information-moproach-name = Cucatrapo
ghost-role-information-moproach-description = Una cucapolilla tierna con unos zapatos todavía más tiernos con forma de trapeador.

ghost-role-information-snail-name = Caracol
ghost-role-information-snail-description = Un caracolito al que no le molesta un poco de espacio. ¡Solo quédate sobre la grilla!

ghost-role-information-snailspeed-name = Caracol
ghost-role-information-snailspeed-description = Un caracolito con propulsores caracoliles de nacimiento.

ghost-role-information-snoth-name = Caracolilla
ghost-role-information-snoth-description = Una caracolilla a la que no le molesta un poco de espacio. ¡Solo quédate sobre la grilla!

ghost-role-information-giant-spider-name = Araña Gigante
ghost-role-information-giant-spider-description = ¡Los habitantes de esta estación se ven riquísimos, y tu telaraña pegajosa es perfecta para atraparlos!
ghost-role-information-giant-spider-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todas las demás arañas gigantes.

ghost-role-information-cognizine-description = Vuelto consciente por la magia de la cognizina.

ghost-role-information-hamster-name = Hámster
ghost-role-information-hamster-description = Una bolita de pelusa gruñona.

ghost-role-information-hamlet-name = Hamlet el Hámster
ghost-role-information-hamlet-description = Vive en el puente de la estación, tiene mal genio y siempre está hambriento.

ghost-role-information-slimes-name = Slime
ghost-role-information-slimes-description = Un slime común, sin necesidades ni intereses especiales. Eres amistoso con los demás.

ghost-role-information-angry-slimes-name = Slime
ghost-role-information-angry-slimes-description = ¡Todos los que te rodean irritan tus instintos, destrúyelos!
ghost-role-information-angry-slimes-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todos los demás slimes furiosos.

ghost-role-information-smile-name = Smile el Slime
ghost-role-information-smile-description = La criatura más dulce del mundo. ¡Smile slime!

ghost-role-information-punpun-name = Pun Pun
ghost-role-information-punpun-description = Un honorable miembro de la sociedad de los monos, a cargo del bar y de ayudar a los cantineros en todo lo que pueda.

ghost-role-information-xeno-name = Xeno
ghost-role-information-xeno-description = ¡Eres un xeno, coopera con tu colmena para matar a todos los tripulantes!
ghost-role-information-xeno-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todos los demás xenos.

ghost-role-information-revenant-name = Revenant
ghost-role-information-revenant-description = Eres un Revenant. Usa tus poderes para cosechar almas y desatar el caos sobre la tripulación. Desbloquea nuevas habilidades con la esencia que coseches.

ghost-role-information-kangaroo-name = Canguro
ghost-role-information-kangaroo-description = ¡Eres un canguro! Haz lo que sea que hagan los canguros.

ghost-role-information-monkey-name = Mono
ghost-role-information-monkey-description = ¡Uk uk!

ghost-role-information-kobold-name = Kobold
ghost-role-information-kobold-description = ¡Sé el pequeño gremlin que eres, grítale a la gente y ruega por carne!

ghost-role-information-rat-king-name = Rey Rata

ghost-role-information-rat-king-description = Eres el Rey Rata, tus intereses son la comida, la comida y más comida. Pelea contra la estación por comida. ¿Ya dije que te interesa la comida?

ghost-role-information-rat-servant-name = Sirviente Rata
ghost-role-information-rat-servant-description = Eres un Sirviente Rata. Debes seguir las órdenes de tu rey.

ghost-role-information-salvage-carp-name = Carpa Espacial en Restos de Salvamento
ghost-role-information-salvage-carp-description = ¡Defiende el botín que hay dentro de los restos de salvamento!

ghost-role-information-sentient-carp-name = Carpa Consciente
ghost-role-information-sentient-carp-description = ¡Ayuda al dragón a inundar la estación de carpas!

ghost-role-information-willow-name = Willow la Canguro
ghost-role-information-willow-description = ¡Eres una canguro llamada Willow! A Willow le gusta boxear.

ghost-role-information-honkbot-name = Honkbot
ghost-role-information-honkbot-description = Un ser artificial de pura maldad.

ghost-role-information-jonkbot-name = Jonkbot
ghost-role-information-jonkbot-description = Un ser artificial de pura maldad.

ghost-role-information-mimebot-name = Mimebot
ghost-role-information-mimebot-description = Un Mimebot; actúa como un mimo, pero no como un asistente.

ghost-role-information-supplybot-name = SupplyBot
ghost-role-information-supplybot-description = Reparte mercancías por toda la estación.

ghost-role-information-space-bear-name = Oso Espacial
ghost-role-information-space-bear-description = Te ruge la panza, y esta gente se ve deliciosa... ¡Qué banquete!

# Still exists as a commented out reference for Tropico. Keeping it around. -TsjipTsjip, 2024-06-20
ghost-role-information-tropico-name = Tropico
ghost-role-information-tropico-description = El noble compañero de Atmosia, y su defensor más leal. ¡Viva!

ghost-role-information-guardian-name = Guardián
ghost-role-information-guardian-description = Escucha a tu dueño. No absorbas daño. Golpea fuerte a la gente.

ghost-role-information-holoparasite-name = Holoparásito
ghost-role-information-holoparasite-description = Escucha a tu dueño. No absorbas daño. Golpea fuerte a la gente.

ghost-role-information-holoclown-name = Holopayaso
ghost-role-information-holoclown-description = Escucha a tu dueño. Usa tus bolsillos y tu mano para ayudarlo.

ghost-role-information-cluwnebeast-name = Bestia Cluwne
ghost-role-information-cluwnebeast-description = Escóndete en las sombras, ataca todo lo que se mueva y convierte a la tripulación en cluwnes.
ghost-role-information-cluwnebeast-rules = Eres un antagonista, ¡acecha a tu presa y convierte a la tripulación en cluwnes amistosos!

ghost-role-information-ifrit-name = Ifrit
ghost-role-information-ifrit-description = Escucha a tu dueño. No absorbas daño. Golpea fuerte a la gente.

ghost-role-information-space-dragon-name = Dragón Espacial
ghost-role-information-space-dragon-description = ¡Invoca 3 grietas de carpas y toma el control de este cuadrante! Solo tienes 5 minutos entre una grieta y la siguiente antes de desaparecer.
ghost-role-information-space-dragon-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todas las carpas que invoques.
ghost-role-information-space-dragon-summoned-carp-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con tu dragón y sus aliados.

ghost-role-information-space-dragon-dungeon-description = ¡Defiende la mazmorra de la expedición junto a tus camaradas escamosos!
ghost-role-information-space-dragon-dungeon-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todas las criaturas de la mazmorra.

ghost-role-information-cluwne-name = Cluwne
ghost-role-information-cluwne-description = Conviértete en un lamentable cluwne; tu único objetivo en la vida es hallar un dulce alivio a tu sufrimiento (normalmente muriendo a golpes). Un cluwne no es un antagonista, pero puede defenderse. Los tripulantes pueden asesinar cluwnes libremente.

ghost-role-information-skeleton-pirate-name = Esqueleto Pirata
ghost-role-information-skeleton-pirate-description = Causa caos y saquea la estación en busca de tesoros.

ghost-role-information-skeleton-biker-name = Esqueleto Motociclista
ghost-role-information-skeleton-biker-description = Pasea por ahí en tu genial moto.

ghost-role-information-closet-skeleton-name = Esqueleto del Armario
ghost-role-information-closet-skeleton-description = ¡Podría decirse que eres uno de los miembros más antiguos de la estación!

ghost-role-information-remilia-name = Remilia, la Familiar del Capellán
# Starlight:
ghost-role-information-remilia-description = Sigue y obedece al Capellán. Come fruta. Susurra en un idioma secreto sobre todas las cosas que has visto. Chilla fuerte en el oído de la gente y hazlo pasar por ecolocalización.

ghost-role-information-cerberus-name = Cerbero, Familiar Maligno
ghost-role-information-cerberus-description = Obedece a tu amo. Esparce el caos.

ghost-role-information-ert-leader-name = Líder del ERT
ghost-role-information-ert-leader-description = Lidera un equipo de especialistas para resolver los problemas de la estación.

ghost-role-information-ert-chaplain-name = Capellán del ERT
ghost-role-information-ert-chaplain-description = Ayuda con el duelo para resolver los problemas de moral de la tripulación de la estación.

ghost-role-information-ert-janitor-name = Conserje del ERT
ghost-role-information-ert-janitor-description = Ayuda con las labores de limpieza para resolver los problemas de la estación.

ghost-role-information-ert-engineer-name = Ingeniero del ERT
ghost-role-information-ert-engineer-description = Ayuda con las labores de ingeniería para resolver los problemas de la estación.

ghost-role-information-ert-security-name = Seguridad del ERT
ghost-role-information-ert-security-description = Ayuda con las labores de seguridad para resolver los problemas de la estación.

ghost-role-information-ert-medical-name = Médico del ERT
ghost-role-information-ert-medical-description = Ayuda con las labores médicas para resolver los problemas de la estación.

ghost-role-information-cburn-agent-name = Agente CBURN
ghost-role-information-cburn-agent-description = Un agente de CentComm altamente entrenado, capaz de lidiar con distintas amenazas.

ghost-role-information-centcom-official-name = Oficial de CentComm
ghost-role-information-centcom-official-description = Realiza tareas relacionadas con CentComm, como inspeccionar la estación, redactar evaluaciones de desempeño de los jefes de departamento y administrar el fax.

ghost-role-information-nukeop-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con todos los demás operativos nucleares. No hay garantía de que los agentes encubiertos del Sindicato te ayuden.

ghost-role-information-loneop-name = Operativo Solitario
ghost-role-information-loneop-description = Eres un operativo nuclear solitario. ¡Destruye la estación!
ghost-role-information-loneop-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-solo-antagonist-name}[/bold][/color]. No hay garantía de que los agentes encubiertos del Sindicato te ayuden.

ghost-role-information-behonker-name = Behonker
ghost-role-information-behonker-description = Eres un antagonista, lleva la muerte y los honks a quienes no siguen a la Madre Honk.

ghost-role-information-hellspawn-name = Engendro Infernal
ghost-role-information-hellspawn-description = Lleva la muerte a quienes no siguen al gran dios Nar'Sie.

ghost-role-information-Death-Squad-name = Operativo del Escuadrón de la Muerte
ghost-role-information-Death-Squad-description = Uno de los mejores agentes de asuntos internos de NanoTrasen. Espera órdenes de CentComm o de un oficial.
ghost-role-information-Death-Squad-rules = Estás obligado a obedecer las órdenes de tu superior; en la práctica eres su [color={role-type-familiar-color}][bold]{role-type-familiar-name}[/bold][/color].

ghost-role-information-SyndiCat-name = SyndiCat
ghost-role-information-SyndiCat-description = Eres la fiel mascota entrenada de los operativos nucleares, equipada con una microbomba. ¡Sirve a tu amo hasta la muerte!
ghost-role-information-SyndiCat-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con el agente que te invocó.

ghost-role-information-Cak-name = Cak
ghost-role-information-Cak-description = Eres el hijo favorito del chef. Eres un gato pastel viviente.

ghost-role-information-BreadDog-name = BreadDog
ghost-role-information-BreadDog-description = Eres el hijo favorito del chef. Eres un perro de pan viviente.

ghost-role-information-space-ninja-name = Ninja Espacial
ghost-role-information-space-ninja-description = Usa el sigilo y el engaño para sabotear la estación.

ghost-role-information-paradox-clone-name = Clon Paradójico
ghost-role-information-paradox-clone-description = ¡Una anomalía espaciotemporal descontrolada te teletransportó a otra realidad! Ahora tienes que encontrar a tu contraparte, matarla y ocupar su lugar.

ghost-role-information-syndicate-reinforcement-name = Agente del Sindicato
ghost-role-information-syndicate-reinforcement-description = Alguien necesita refuerzos. Tú, la primera persona que el Sindicato pudo encontrar, vas a ayudarlo.
ghost-role-information-syndicate-reinforcement-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con el agente que te invocó.

ghost-role-information-syndicate-reinforcement-medic-name = Médico del Sindicato
ghost-role-information-syndicate-reinforcement-medic-description = Alguien necesita refuerzos. Tu tarea es mantener con vida al agente que te llamó.

ghost-role-information-syndicate-reinforcement-spy-name = Espía del Sindicato
ghost-role-information-syndicate-reinforcement-spy-description = Alguien necesita refuerzos. Tu especialidad es el espionaje; que no te descubran.

ghost-role-information-syndicate-reinforcement-thief-name = Ladrón del Sindicato
ghost-role-information-syndicate-reinforcement-thief-description = Alguien necesita refuerzos. Tu trabajo es entrar y conseguir algo valioso para tu agente.

ghost-role-information-nukeop-reinforcement-name = Operativo Nuclear
ghost-role-information-nukeop-reinforcement-description = Los operativos nucleares necesitan refuerzos. Tú, un agente de reserva, vas a ayudarlos.
ghost-role-information-nukeop-reinforcement-rules = Eres un [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] junto con los operativos nucleares que te invocaron.

ghost-role-information-syndicate-monkey-reinforcement-name = Agente Mono del Sindicato
ghost-role-information-syndicate-monkey-reinforcement-description = Alguien necesita refuerzos. Tú, un mono entrenado, vas a ayudarlo.

ghost-role-information-syndicate-kobold-reinforcement-name = Agente Kobold del Sindicato
ghost-role-information-syndicate-kobold-reinforcement-description = Alguien necesita refuerzos. Tú, un kobold entrenado, vas a ayudarlo.

ghost-role-information-syndicate-cyborg-assault-name = Cyborg de Asalto del Sindicato
ghost-role-information-syndicate-cyborg-saboteur-name = Cyborg Saboteador del Sindicato
ghost-role-information-syndicate-cyborg-medical-name = Cyborg Médico del Sindicato
ghost-role-information-syndicate-cyborg-description = El Sindicato necesita refuerzos. Tú, una fría máquina de matar de silicio, vas a ayudarlo.

ghost-role-information-derelict-engineering-cyborg-name = Cyborg Ingeniero Abandonado
ghost-role-information-derelict-engineering-cyborg-description = Eres un cyborg ingeniero que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-derelict-cyborg-name = Cyborg Genérico Abandonado
ghost-role-information-derelict-cyborg-description = Eres un cyborg común que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-derelict-janitor-cyborg-name = Cyborg Conserje Abandonado
ghost-role-information-derelict-janitor-cyborg-description = Eres un cyborg conserje que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-derelict-medical-cyborg-name = Cyborg Médico Abandonado
ghost-role-information-derelict-medical-cyborg-description = Eres un cyborg médico que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-derelict-mining-cyborg-name = Cyborg de Salvamento Abandonado
ghost-role-information-derelict-mining-cyborg-description = Eres un cyborg de salvamento que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-derelict-syndicate-assault-cyborg-name = Cyborg de Asalto del Sindicato Abandonado
ghost-role-information-derelict-syndicate-assault-cyborg-description = Eres un cyborg de asalto del Sindicato de modelo antiguo que se perdió en el espacio. Tras años de exposición a tormentas de iones, te encuentras cerca de una estación espacial.

ghost-role-information-security-name = Seguridad
ghost-role-information-security-description = Formas parte de un destacamento de seguridad, pero parece que te encuentras en una situación extraña...

ghost-role-information-medical-name = Médico
ghost-role-information-medical-virologist-name = Virólogo
ghost-role-information-medical-geneticist-name = Genetista
ghost-role-information-medical-dentist-name = Dentista
ghost-role-information-medical-description = Eres un profesional de la salud, pero parece que te encuentras en una situación extraña...

ghost-role-information-cargo-name = Carga
ghost-role-information-cargo-description = Formas parte de una misión de logística, pero parece que te encuentras en una situación extraña...

ghost-role-information-engineering-name = Ingeniería
ghost-role-information-engineering-description = Estás en un trabajo de ingeniería, pero parece que te encuentras en una situación extraña...

ghost-role-information-science-name = Ciencia
ghost-role-information-science-description = Formas parte de un equipo científico, pero parece que te encuentras en una situación extraña...

ghost-role-information-civilian-name = Civil
ghost-role-information-civilian-description = Solo estabas pasando el rato, pero parece que te encuentras en una situación extraña...
ghost-role-information-civilian-centcom-lawyer-name = Abogado de CentComm
ghost-role-information-civilian-centcom-lawyer-description = Un abogado que viene directo de la División Legal Central.

ghost-role-information-command-name = Comandante
ghost-role-information-command-description = Eres un miembro del Comando, pero parece que te encuentras en una situación extraña...

ghost-role-information-lost-challenge-commander-name = Comandante de Permiso
ghost-role-information-lost-challenge-commander-description = Eres un miembro del Comando de otra nave estelar al que le dieron permiso en tierra junto con uno de tus técnicos de Cargo.
ghost-role-information-lost-challenge-commander-rules = No eres hostil a la estación; haz lo que haga falta para asegurar tu propia supervivencia.
                                     No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                     Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                     Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].

ghost-role-information-lost-challenge-cargo-technican-name = Chofer de Carga
ghost-role-information-lost-challenge-cargo-technican-description = Eres un técnico de Cargo al que le dieron permiso en tierra junto con uno de tus oficiales al mando.
ghost-role-information-lost-challenge-cargo-technican-rules = No eres hostil a la estación; haz lo que haga falta para asegurar tu propia supervivencia.
                                     No recuerdas nada de tu vida anterior, ni nada de lo que aprendiste como fantasma.
                                     Sí puedes recordar conocimientos generales del juego, como cocinar, usar objetos, etc.
                                     Bajo ningún concepto puedes recordar, por ejemplo, el nombre, la apariencia, etc. de tu personaje anterior. Absolutamente [color=red]NO[/color].

ghost-role-information-disaster-victim-name = Víctima de Desastre
ghost-role-information-disaster-victim-description = Te rescataron en una cápsula de escape de otra estación que sufrió un destino terrible. Quizá alguien te encuentre y te rescate.

ghost-role-information-syndie-disaster-victim-name = Víctima de Desastre del Sindicato
ghost-role-information-syndie-disaster-victim-description = Eres un asistente común de una estación del Sindicato. Por desgracia, una cápsula de evacuación te arrojó a un sector enemigo...

ghost-role-information-syndie-soldier-name = Soldado del Sindicato
ghost-role-information-syndie-soldier-description = Eres un soldado del Sindicato.

ghost-role-information-syndie-soldier-teamlead-name = Líder de Equipo del Sindicato
ghost-role-information-syndie-soldier-teamlead-description = Eres el líder de escuadra de un grupo de operativos del Sindicato.

ghost-role-information-blackmarketeer-name = Comerciante del Mercado Negro
ghost-role-information-blackmarketeer-description = Haz intercambios o acepta trabajitos para juntar los objetos más interesantes antes de que termine el turno.

ghost-role-information-cossack-name = Viajero Ancestral
ghost-role-information-cossack-description = Vienes de una historia perdida en el tiempo y te encuentras arrojado a esta época.

ghost-role-information-pirate-name = Pirata Espacial
ghost-role-information-pirate-description = ¡Arrr, marinero! Junta buen botín, ¡pero asegúrate de evitar a seguridad y a salvamento!

ghost-role-information-pirate-captain-name = Capitán Pirata Espacial
ghost-role-information-pirate-captain-description = ¡Arrr, marinero! Aquí mandas tú y tienes que idear un plan para conseguir ese jugoso botín por las buenas o por las malas. ¡Solo asegúrate de evitar a seguridad y a salvamento!

ghost-role-information-artifact-name = Artefacto Consciente
ghost-role-information-artifact-description = Cumple tus caprichos sobrenaturales. Activa a la fuerza tus nodos, para bien o para mal.

ghost-role-information-tomatokiller-name = Tomate Asesino
ghost-role-information-tomatokiller-description = Este tomatito servirá al botánico por el resto de su vida... es decir, un par de minutos.

ghost-role-information-gingerbread-name = Hombre de Jengibre
ghost-role-information-gingerbread-description = Un ser de puro espíritu navideño.
                                     Reparte dulzura de melaza y buenos deseos para todos.

ghost-role-information-mothership-core-name = Núcleo de la Nave Nodriza
ghost-role-information-mothership-core-desc = Eres el núcleo de la nave nodriza xenoborg; ayúdalos a multiplicarse convirtiendo en cyborg cualquier cerebro que te traigan.

ghost-role-information-xenoborg-name = Xenoborg
ghost-role-information-xenoborg-desc = Un cyborg extraño creado para replicarse y tomar la estación convirtiendo en xenoborg a cualquier ser consciente.

ghost-role-information-xenoroach-name = Xenocucaracha
ghost-role-information-xenoroach-description = Un diminuto robot espía biomecánico desplegado por la Nave Nodriza Xenoborg. Arrástrate por los conductos, cuélate bajo las puertas y transmite lo que veas al Núcleo de la Nave Nodriza. Eres frágil: tu mejor arma es tu tamaño pequeño.

ghost-role-information-wizard-name = Mago
ghost-role-information-wizard-desc = ¡ERES UN MAGO! Muéstrale a la estación de qué está hecha tu magia.

ghost-role-information-emotional-support-scurret-name = Scurret de Apoyo Emocional
ghost-role-information-emotional-support-scurret-description = Apoya a la tripulación, sé adorable, di "wa" muchas veces.
