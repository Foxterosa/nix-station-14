# addaction
cmd-addaction-desc = Agrega una acción a la entidad objetivo. La acción no funcionará si el objetivo requiere un componente adicional en su entidad (como el Devorar del dragón).
cmd-addaction-help = addaction <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = Se esperaban exactamente 2 argumentos.
cmd-addaction-actions-not-found = La entidad objetivo no puede usar acciones.
cmd-addaction-action-not-found = No se encuentra un prototipo de acción que coincida con {$action}.
cmd-addaction-adding-failed = No se pudo agregar la acción.

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <ActionProto>
