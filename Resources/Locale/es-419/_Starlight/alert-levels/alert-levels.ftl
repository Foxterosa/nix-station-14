alert-level-announcement-sender = ¡Atención! ¡{$sender} ha declarado la alerta {$name}! {$announcement}

alert-level-omega = Omega
alert-level-omega-announcement = Las fluctuaciones en la Cicatriz Nula indican que esta estación está fuera de fase con su realidad habitual. Esperamos que lo que hayan hecho haya valido la pena.
alert-level-omega-instructions = Reconsiderá tus decisiones.

alert-level-theta = Theta
alert-level-theta-announcement = Heri vixisti, hodi mori meministi.
alert-level-theta-instructions = Recordá tu mortalidad.

alert-level-psi = Psi
alert-level-psi-announcement = Eviten cualquier cíborg que no cumpla con las especificaciones de NanoTrasen. No vayan solos. No se entreguen en silencio. Consulten a los jefes de personal para recibir instrucciones.
alert-level-psi-instructions = Evitá a los cíborgs hostiles.

alert-level-orange = Naranja
alert-level-orange-announcement = Existe una amenaza estructural o atmosférica crítica en toda la estación y es improbable recuperarla. Ingeniería deberá minimizar los riesgos y asegurar el muelle de evacuación. La tripulación deberá evitar las zonas peligrosas y prepararse para una probable evacuación.
alert-level-orange-instructions = Evitá los peligros y preparate para evacuar.
